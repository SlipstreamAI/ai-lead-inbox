# Copy to .env if you want live model or Slack delivery.
# Mock mode is the default and needs none of these.

LLM_MODE=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

# Leave empty to keep alerts in the in-app inbox.
SLACK_WEBHOOK_URL=

# Used when the form checkbox sends the lead through n8n.
# Inside docker compose the web service overrides this to http://n8n:5678/webhook/lead.
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/lead

DATA_DIR=./data
PORT=4317

# Optional Jev (TypeSafe) scoring. Bring your own key.
# When TYPESAFE_API_KEY is set, each lead makes one POST to
# https://api.typesafe.ai/v1/systemone with model jev-1.13.0.
# If the key is empty or the call fails, the local rubric scores the lead.
# Never commit a real key. .env is gitignored.
TYPESAFE_API_KEY=
JEV_CONFIDENCE_THRESHOLD=0.6
JEV_TIMEOUT_MS=20000
